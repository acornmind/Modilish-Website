[Unit]
Description=Modilish Next.js app (app.modilish.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=modilish
Group=modilish
WorkingDirectory=/srv/modilish/current
EnvironmentFile=/srv/modilish/shared/env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
