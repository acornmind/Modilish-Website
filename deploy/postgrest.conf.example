# /etc/postgrest.conf (root:postgrest, mode 640). The real file holds generated secrets.
# supabase-js talks to PostgREST exactly like it talks to Supabase; the app's
# SUPABASE_SERVICE_ROLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY on the server are
# HS256 JWTs ({"role":"service_role"} / {"role":"anon"}) signed with jwt-secret.
db-uri = "postgres://authenticator:<generated-password>@127.0.0.1:5432/modilish"
db-schemas = "public"
db-anon-role = "anon"
jwt-secret = "<generated-64-hex-chars>"
server-host = "127.0.0.1"
server-port = 3001
db-pool = 10
